    "@job-market/oxlint-config": "workspace:*",
    "@job-market/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-orm": "0.45.4",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "pg": "8.23.1",
    "typescript": "7.0.2"
  }
