{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["./base.json"],
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "node",
    "promise",
    "react",
    "react-perf",
    "jsx-a11y",
    "nextjs"
  ],
  "env": {
    "browser": true
  },
  "rules": {
    "react/jsx-key": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "react/jsx-filename-extension": [
      "error",
      {
        "extensions": [".tsx"]
      }
    ],
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "package": "react",
            "name": ["ReactNode", "ReactElement", "JSX.Element"]
          }
        ],
        "treatMethodsAsReadonly": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/app/**/*.tsx", "*.config.ts", "*.config.mjs"],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ]
}
