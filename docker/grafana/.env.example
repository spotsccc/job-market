# Подключение локальной Grafana к базе прода на Neon. Скопируйте в docker/grafana/.env и заполните:
# файл не попадает в git. Роль grafana и её пароль заводит SQL из раздела «Мониторинг» README.
# Хост Neon без порта, например ep-xxx-123456.eu-central-1.aws.neon.tech
NEON_HOST=
# База на Neon, например neondb
NEON_DATABASE=
GRAFANA_DB_PASSWORD=
