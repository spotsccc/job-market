{
  "extends": "@job-market/typescript-config/nextjs.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src",
    "scripts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "*.config.ts"
  ],
  "exclude": ["node_modules"]
}
