{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "if [ \"$VERCEL_ENV\" = production ]; then NODE_ENV=production pnpm db:migrate; fi && pnpm build",
  "schedules": {
    "sources-tick": {
      "schedule": "0 * * * *",
      "path": "/api/cron/tick",
      "requestMethod": "GET"
    }
  },
  "functions": {
    "src/app/api/queues/drain-source/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "drain-source",
          "retryAfterSeconds": 60,
          "maxDeliveries": 3,
          "maxConcurrency": 20
        }
      ]
    },
    "src/app/api/queues/mine/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "mine",
          "retryAfterSeconds": 60,
          "maxConcurrency": 5
        }
      ]
    }
  }
}
