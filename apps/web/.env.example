# Скопируйте в .env.local и заполните.

# Локальная база из compose.yaml (поднимается в `pnpm dev`).
DATABASE_URL=postgres://job_market:job_market@localhost:5433/job_market

# Ключ Vercel AI Gateway для моделей, которые разбирают посты. На Vercel можно не задавать: возьмётся OIDC-токен деплоя.
AI_GATEWAY_API_KEY=

# Токен Apify: коннектор LinkedIn и читатели ссылок енричера — в движке (роуты опроса и разбора) и при переносе постов (`pnpm --filter @job-market/web vacancies:transfer`).
APIFY_TOKEN=

# Секрет расписания sources-tick: Vercel шлёт его в `Authorization: Bearer` при вызове /api/cron/tick.
CRON_SECRET=
