# Скопируйте в .env.local и заполните.

# Токен Apify для поиска постов LinkedIn.
LINKEDINN_CHANNEL_KEY=

# Локальная база из compose.yaml (поднимается в `pnpm dev`).
DATABASE_URL=postgres://job_market:job_market@localhost:5433/job_market

# Ключ Vercel AI Gateway для моделей, которые разбирают посты. На Vercel можно не задавать: возьмётся OIDC-токен деплоя.
AI_GATEWAY_API_KEY=

# Секрет ежедневного сбора Telegram (/api/cron/telegram). На Vercel его задают в настройках проекта, Vercel Cron передаёт его в Authorization. Локально — любая строка, вызов: curl -H "Authorization: Bearer $CRON_SECRET" "localhost:3000/api/cron/telegram?channels=forproducts".
CRON_SECRET=
