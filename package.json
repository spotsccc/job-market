{
  "name": "job-market",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "check": "turbo run format:check lint check-types",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "grafana:up": "pnpm --filter @job-market/dashboards build && docker compose up -d --wait grafana",
    "db:generate": "pnpm --filter @job-market/db generate",
    "db:migrate": "pnpm --filter @job-market/web db:migrate",
    "db:migrate:test": "pnpm --filter @job-market/web db:migrate:test",
    "geo:build": "pnpm --filter @job-market/geo geo:build"
  },
  "devDependencies": {
    "@job-market/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "turbo": "2.11.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0"
}
